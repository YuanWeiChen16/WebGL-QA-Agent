# WebGL QA Agent — environment variables template
# ------------------------------------------------------------------
# 1. Copy this file to `.env`  ->  cp .env.example .env
# 2. Fill in your real values below.
# 3. NEVER commit your real `.env` (it is git-ignored).
#
# NOTE: scripts read these via os.environ; they do NOT auto-load `.env`.
# Load them into your shell first, e.g.:
#   - PowerShell:  Get-Content .env | %% { $kv=$_ -split '=',2; if($kv[0] -and $kv[0][0] -ne '#'){ [Environment]::SetEnvironmentVariable($kv[0],$kv[1]) } }
#   - bash/zsh:    set -a && source .env && set +a
#   - or install python-dotenv and load it at the top of your entry script.

# --- Vision LLM gateway (Anthropic-compatible endpoint) ---
VISION_GATEWAY_URL=https://your-vision-gateway.example.com
VISION_API_KEY=replace-with-your-api-key

# --- Target WebGL game under test ---
# Any WebGL game URL. Example public demo: https://webglsamples.org/aquarium/aquarium.html
GAME_URL=https://example.com/your-webgl-game/index.html

# --- Login/account id used by the login sequence (only if your game needs one) ---
LOGIN_ID=your-test-account-id
